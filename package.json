{
  "name": "browser-agent-bridge",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build-sdk.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "bridge": "node bridge/cli.mjs --transport http",
    "mcp": "node bridge/cli.mjs",
    "host": "python3 server/serve.py",
    "mcp:http": "node bridge/cli.mjs --transport http",
    "mcp:stdio": "node bridge/cli.mjs --transport stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "^3.25.0"
  },
  "bin": {
    "browser-agent-bridge": "bridge/cli.mjs"
  }
}
